# =============================================================================
# OUT LMS Headless Frontend Configuration
# All URLs are resolved dynamically at runtime based on active host/origin
# to support 127.0.0.1, localhost, LAN IP, Docker, and cloud deployments.
# =============================================================================

# Leave REACT_APP_MOODLE_URL unset so apiClient resolves same-origin /moodle-backend dynamically
# REACT_APP_MOODLE_URL=

# Default Moodle External Service name for Token generation
REACT_APP_MOODLE_SERVICE=moodle_mobile_app

# Active Web Service Token for public catalog & site info queries
REACT_APP_MOODLE_TOKEN=cac3488049fb0d8247867a568bea7c79

# Mock Mode (Set to false for live production / active development with Moodle)
REACT_APP_USE_MOCK=false
