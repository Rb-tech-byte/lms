# Server Port
PORT=5000

# Moodle 5.3 Backend Configuration
MOODLE_URL=http://localhost:8080/moodle
MOODLE_WS_TOKEN=your_moodle_super_admin_token_here

# Pesapal API v3 Credentials
PESAPAL_CONSUMER_KEY=your_pesapal_consumer_key
PESAPAL_CONSUMER_SECRET=your_pesapal_consumer_secret
PESAPAL_ENVIRONMENT=sandbox
PESAPAL_IPN_ID=your_registered_ipn_id

# Selcom Paypoint Credentials
SELCOM_API_KEY=your_selcom_api_key
SELCOM_API_SECRET=your_selcom_api_secret
SELCOM_VENDOR_ID=your_selcom_vendor_id
SELCOM_ENVIRONMENT=sandbox
