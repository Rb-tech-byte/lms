# -----------------------------------------------------------------------------
# OUT LMS - Frontend Production Dockerfile
# Multi-stage build for React 18 TypeScript Portal
# -----------------------------------------------------------------------------

FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies
COPY frontend/package*.json ./
RUN npm ci --legacy-peer-deps

# Copy frontend source and public assets
COPY frontend/ ./

# Build optimized production bundle
RUN npm run build

# -----------------------------------------------------------------------------
# Production Runtime Image
# -----------------------------------------------------------------------------
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

# Copy built assets and server runner
COPY --from=builder /app/build ./build
COPY --from=builder /app/public ./public
COPY --from=builder /app/serve_build.js ./serve_build.js
COPY --from=builder /app/package*.json ./

# Expose standard frontend port
EXPOSE 3000

# Run lightweight production asset server
CMD ["node", "serve_build.js"]

