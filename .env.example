# Application Ports
FRONTEND_PORT=3000
BACKEND_PORT=8080
DB_PORT=3306

# Database Connection (MySQL / MariaDB)
MOODLE_DB_TYPE=mariadb
MOODLE_DB_HOST=127.0.0.1
MOODLE_DB_PORT=3306
MOODLE_DB_NAME=moodle_out
MOODLE_DB_USER=root
MOODLE_DB_PASSWORD=
MOODLE_DB_PREFIX=mdl_

# Base URLs (Auto-detected if left empty)
APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
MOODLE_WWWROOT=http://127.0.0.1/outlmstheme/moodle-backend

# Data Directory (Relative or Absolute path)
# Default searches parent directories for /moodledata outside webroot
MOODLE_DATAROOT=./moodledata

